{
  "name": "dividendii-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Dividendii Investments: trading, invest tab, public offers, bonds and gifting on the Bluum Finance API",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n server,web -c blue,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
