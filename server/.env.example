# Copy to server/.env and restart. Never commit the real .env.

# ---------------------------------------------------------------------------
# Bluum
# ---------------------------------------------------------------------------
# mock  = no Bluum calls at all. Everything is answered from built-in sample
#         data. This is the default so the platform runs before keys arrive.
# live  = every call goes to Bluum using the key below.
BLUUM_MODE=mock

# sandbox or production. Production is refused unless BLUUM_ALLOW_PRODUCTION=true.
BLUUM_ENV=sandbox
BLUUM_ALLOW_PRODUCTION=false

# From the Bluum dashboard. Sandbox keys only during development.
# The key never leaves this server. It is never sent to the browser.
BLUUM_API_KEY=
BLUUM_API_SECRET=

# Shared secret Bluum signs webhook bodies with (X-Bluum-Signature).
BLUUM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# This server
# ---------------------------------------------------------------------------
PORT=4000
# Where the web app runs, for CORS.
WEB_ORIGIN=http://localhost:5173
# Signs Dividendii's own session tokens. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave blank to run on an in-memory store (data is lost when the server
# stops). Set it to a Postgres URL for a real database:
#   postgres://user:password@host:5432/dividendii
DATABASE_URL=

# ---------------------------------------------------------------------------
# Email (one-time codes and notices). No SMS.
# ---------------------------------------------------------------------------
# console = codes are printed in the server log instead of being emailed.
# smtp    = real email through the settings below.
MAIL_MODE=console
MAIL_FROM="Dividendii Investments <no-reply@dividendii.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# KYC documents (partner-managed KYC)
# ---------------------------------------------------------------------------
# forward-only = documents are streamed to Bluum and never written to disk.
#                This is the safest setting and the default.
# store        = documents are also kept in KYC_DIR. Only switch this on once
#                you have a data-protection officer and encrypted storage.
KYC_STORAGE=forward-only
KYC_DIR=./.kyc-uploads

# ---------------------------------------------------------------------------
# Markets live at launch
# ---------------------------------------------------------------------------
MARKETS=NG,US,KE
